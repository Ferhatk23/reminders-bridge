# Apple-ID, mit der die Erinnerungen synchronisiert werden.
ICLOUD_USERNAME=du@example.org

# Optionaler Schutz der API. Leer lassen, wenn schon ein authentifizierender
# Reverse Proxy davorsteht; sonst unbedingt setzen.
API_TOKEN=

TZ=Europe/Berlin
PORT=8000
WEB_PORT=8080

# Nur bei getrenntem Betrieb: die API soll die Oberfläche dann nicht ausliefern.
# SERVE_WEB=false

# Wie oft der Hintergrund-Sync läuft, solange die API benutzt wird.
SYNC_DELTA_SECONDS=45
SYNC_FULL_SECONDS=300
SYNC_ACTIVE_WINDOW=600
